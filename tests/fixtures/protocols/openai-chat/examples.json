        "messages": [
          {
            "role": "system",
            "content": "Read only the requested file."
          },
          {
            "role": "user",
            "content": "Read notes.txt."
          },
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_fixture_1",
                "type": "function",
                "function": {
                  "name": "read_file",
                  "arguments": "{ \"path\": \"notes.txt\" }"
                }
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_fixture_1",
            "content": "moyyi_status=unknown; execution outcome is unknown; verify before retrying."
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read_file",
              "description": "Read one authorized file.",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            }
          }
        ],
        "n": 1,
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    },
    {
      "id": "qwen-reasoning-request",
      "body": {
        "model": "Qwen/Qwen3-8B",
