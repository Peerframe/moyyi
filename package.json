{
  "name": "moyyi",
  "version": "0.0.0",
  "description": "A personal general-purpose agent with a self-owned core.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11"
  },
  "bin": {
    "moyyi": "dist/cli/main.js"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist/",
    "npm-shrinkwrap.json",
    "docs/installation.md",
    "docs/client-protocol.md",
    "docs/cli.md",
    "docs/deepseek.md",
    "docs/anthropic.md",
    "docs/files.md",
    "docs/documents.md",
    "docs/writes.md",
    "docs/shell.md",
    "docs/long-sessions.md",
    "docs/instructions.md",
    "docs/web.md",
    "docs/skills.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "moyyi": "node src/cli/main.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build && node scripts/package-lock.ts",
    "postpack": "node scripts/package-lock.ts --clean",
    "package:candidate": "node scripts/package-candidate.ts",
    "verify:package": "node scripts/verify-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "eval": "node evals/run.ts",
    "eval:core": "node evals/core/run.ts",
    "demo:scripted": "node scripts/demo-agent.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval:files": "node evals/files/run.ts",
    "eval:documents": "node evals/documents/run.ts",
    "demo:files": "node scripts/demo-files.ts",
    "eval:deepseek": "node evals/deepseek/run.ts",
    "demo:deepseek-replay": "node scripts/demo-deepseek-replay.ts",
    "eval:writes": "node evals/writes/run.ts",
    "eval:shell": "node evals/shell/run.ts",
    "eval:long-sessions": "node evals/long-sessions/run.ts",
    "eval:anthropic": "node evals/anthropic/run.ts",
    "eval:web": "node evals/web/run.ts",
    "eval:instructions": "node evals/instructions/run.ts",
    "eval:runtime": "node evals/runtime/run.ts",
    "eval:skills": "node evals/skills/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "officeparser": "7.8.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@borewit/text-codec": "0.2.2",
    "@tokenizer/inflate": "0.4.1",
    "@tokenizer/token": "0.3.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "bmp-js": "0.1.0",
    "debug": "4.4.3",
    "dom-serializer": "3.1.1",
    "domelementtype": "3.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "entities": "8.1.0",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.9",
    "fflate": "0.8.3",
    "file-type": "22.0.2",
    "htmlparser2": "12.0.0",
    "idb-keyval": "6.3.0",
    "ieee754": "1.2.1",
    "ignore": "7.0.12",
    "is-url": "1.2.4",
    "json-schema-traverse": "1.0.0",
    "ms": "2.1.3",
    "node-fetch": "2.7.0",
    "opencollective-postinstall": "2.0.3",
    "pdfjs-dist": "6.3.289",
    "regenerator-runtime": "0.13.11",
    "require-from-string": "2.0.2",
    "strtok3": "10.3.5",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "token-types": "6.1.2",
    "tr46": "0.0.3",
    "uint8array-extras": "1.5.0",
    "wasm-feature-detect": "1.9.0",
    "webidl-conversions": "3.0.1",
    "whatwg-url": "5.0.0",
    "yaml": "2.9.1",
    "zlibjs": "0.3.1"
  },
  "overrides": {
    "pdfjs-dist": "6.3.289"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.9"
  }
}
