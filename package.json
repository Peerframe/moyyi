{
  "name": "moyyi",
  "version": "0.0.0",
  "description": "A personal general-purpose agent with a self-owned core.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11"
  },
  "bin": {
    "moyyi": "dist/cli/main.js"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/installation.md",
    "docs/client-protocol.md",
    "docs/cli.md",
    "docs/deepseek.md",
    "docs/anthropic.md",
    "docs/files.md",
    "docs/writes.md",
    "docs/shell.md",
    "docs/long-sessions.md",
    "docs/instructions.md",
    "docs/web.md"
  ],
  "scripts": {
    "moyyi": "node src/cli/main.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "package:candidate": "node scripts/package-candidate.ts",
    "verify:package": "node scripts/verify-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "eval": "node evals/run.ts",
    "eval:core": "node evals/core/run.ts",
    "demo:scripted": "node scripts/demo-agent.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval:files": "node evals/files/run.ts",
    "demo:files": "node scripts/demo-files.ts",
    "eval:deepseek": "node evals/deepseek/run.ts",
    "demo:deepseek-replay": "node scripts/demo-deepseek-replay.ts",
    "eval:writes": "node evals/writes/run.ts",
    "eval:shell": "node evals/shell/run.ts",
    "eval:long-sessions": "node evals/long-sessions/run.ts",
    "eval:anthropic": "node evals/anthropic/run.ts",
    "eval:web": "node evals/web/run.ts",
    "eval:instructions": "node evals/instructions/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ignore": "7.0.12"
  }
}
