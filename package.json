{
  "name": "moyyi",
  "version": "0.0.0",
  "description": "A personal general-purpose agent with a self-owned core.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11"
  },
  "bin": {
    "moyyi": "dist/cli/main.js"
  },
  "scripts": {
    "moyyi": "node src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "eval": "node evals/run.ts",
    "eval:core": "node evals/core/run.ts",
    "demo:scripted": "node scripts/demo-agent.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
